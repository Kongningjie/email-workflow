APP_ENV=development
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://email_workflow:email_workflow@database:5432/email_workflow
DATA_DIR=/app/data
CONFIG_DIR=/app/config
FRONTEND_DIST_DIR=/app/frontend/dist
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus-2026-05-26
MOCK_GATEWAY_BASE_URL=http://mock-gateway:8001
MOCK_GATEWAY_KEY_ID=local-demo
MOCK_GATEWAY_HMAC_SECRET=replace-with-a-local-demo-secret
RUN_LIVE_LLM_TESTS=0
MAX_UPLOAD_BYTES=5242880
MAX_CLEAN_BODY_CHARS=200000
MAX_HEADER_COUNT=200
MAX_HEADER_VALUE_CHARS=16384
MAX_MIME_DEPTH=10
MAX_MIME_PARTS=100
EVIDENCE_SEGMENT_CHARS=1000
EVIDENCE_OVERLAP_CHARS=100
RAW_RETENTION_HOURS=24
EVIDENCE_RETENTION_DAYS=90
